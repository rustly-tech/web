---
import Base from '../layouts/Base.astro';
import { learningPaths, trials, cheatsheets, snapshot } from '../lib/content';

const paths = learningPaths();
const allTrials = trials();
const sheets = cheatsheets();
const snap = snapshot();
---

<Base title="Rustly" description="Learn Rust by writing, breaking, fixing, and reading real Rust.">
  <section class="hero prose">
    <h1>Learn Rust by writing, breaking, fixing, and reading real Rust.</h1>
    <p class="hero__lede">
      Short lessons where you predict what the compiler will say before you run anything, and the
      real <code>rustc</code> output is part of the explanation rather than something hidden behind it.
      Practice in judged Trials. Read code that actually ships.
    </p>
    <p class="cluster">
      <a class="button" href="/learn/ownership/move-semantics" data-variant="primary"
        >Start with Ownership</a
      >
      <a class="button" href="/trials">Browse Trials</a>
    </p>
  </section>

  <section>
    <h2>The loop</h2>
    <ol class="loop list-reset">
      <li><strong>Read</strong> a short explanation of one idea.</li>
      <li><strong>Predict</strong> what the compiler will say, and commit to it.</li>
      <li><strong>Run</strong> it, and read the real diagnostic next to a human explanation.</li>
      <li><strong>See it in the wild</strong> — the same idea in a real open-source crate.</li>
      <li><strong>Solve a Trial</strong>, then compare your answer with other people's.</li>
    </ol>
  </section>

  <section>
    <h2>Learning paths</h2>
    <div class="card-grid">
      {
        paths.map((path) => (
          <article class="card">
            <h3>
              <a href={`/learn/${path.lessons[0] ?? path.id}`}>{path.title}</a>
            </h3>
            <p>{path.summary}</p>
            <div class="card__meta">
              <span class="tag">
                {path.lessons.length} lesson{path.lessons.length === 1 ? '' : 's'}
              </span>
              {path.topics.map((topic) => (
                <span class="tag">{topic}</span>
              ))}
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section>
    <h2>Trials</h2>
    <div class="card-grid">
      {
        allTrials.map((trial) => (
          <article class="card">
            <h3>
              <a href={`/trials/${trial.slug}`}>{trial.title}</a>
            </h3>
            <p>{trial.summary}</p>
            <div class="card__meta">
              <span class="tag">{trial.difficulty}</span>
              {trial.topics.map((topic) => (
                <span class="tag">{topic}</span>
              ))}
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section>
    <h2>Cheatsheets</h2>
    <div class="card-grid">
      {
        sheets.map((sheet) => (
          <article class="card">
            <h3>
              <a href={`/cheatsheets/${sheet.id}`}>{sheet.title}</a>
            </h3>
            <p>{sheet.summary}</p>
            <div class="card__meta">
              <span class="tag">{sheet.entries.length} entries</span>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <p class="snapshot">
    Built from content <code>{snap.revision.slice(0, 8)}</code>.
  </p>

  <style>
    .hero {
      padding: var(--space-6) 0 var(--space-7);
    }
    .hero h1 {
      font-size: clamp(1.75rem, 4vw, 2.5rem);
      max-width: 20ch;
    }
    .hero__lede {
      font-size: var(--step-1);
      color: var(--ink-muted);
    }
    .loop {
      counter-reset: step;
      max-width: var(--measure);
    }
    .loop li {
      counter-increment: step;
      display: grid;
      grid-template-columns: 2rem 1fr;
      gap: var(--space-3);
      padding: var(--space-2) 0;
      border-bottom: 1px solid var(--rule);
    }
    .loop li::before {
      content: counter(step);
      font-family: var(--mono);
      color: var(--ink-faint);
    }
    section {
      margin-bottom: var(--space-7);
    }
    .snapshot {
      color: var(--ink-faint);
      font-size: 0.8125rem;
    }
  </style>
</Base>
