---
import Base from '../../layouts/Base.astro';
import { learningPaths, lessons, isPublished } from '../../lib/content';

const paths = learningPaths().filter((p) => isPublished(p.lifecycle));
const allLessons = lessons();
---

<Base title="Learn" section="learn" description="Structured Rust learning paths.">
  <div class="prose">
    <h1>Learn</h1>
    <p>
      Short lessons, one idea each. You predict what the compiler will say before you run anything,
      and the real diagnostic is part of the teaching.
    </p>
  </div>

  {
    paths.map((path) => (
      <section>
        <h2>{path.title}</h2>
        <p class="prose">{path.summary}</p>
        <ol class="lesson-list list-reset">
          {path.lessons.map((id, index) => {
            const lesson = allLessons.find((l) => l.id === id);
            if (!lesson) return null;
            return (
              <li>
                <span class="lesson-list__number">{index + 1}</span>
                <div>
                  <a href={`/learn/${lesson.id}`}>{lesson.title}</a>
                  <p>{lesson.summary}</p>
                </div>
                <span class="tag">{lesson.lifecycle}</span>
              </li>
            );
          })}
        </ol>
      </section>
    ))
  }

  <style>
    .lesson-list li {
      display: grid;
      grid-template-columns: 2rem 1fr auto;
      gap: var(--space-3);
      align-items: start;
      padding: var(--space-3) 0;
      border-bottom: 1px solid var(--rule);
    }
    .lesson-list__number {
      font-family: var(--mono);
      color: var(--ink-faint);
    }
    .lesson-list p {
      margin: var(--space-1) 0 0;
      color: var(--ink-muted);
      font-size: 0.9375rem;
    }
  </style>
</Base>
