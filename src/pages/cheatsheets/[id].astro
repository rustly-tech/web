---
import Base from '../../layouts/Base.astro';
import { cheatsheets, isPublished } from '../../lib/content';

export function getStaticPaths() {
  return cheatsheets()
    .filter((sheet) => isPublished(sheet.lifecycle))
    .map((sheet) => ({ params: { id: sheet.id }, props: { sheet } }));
}

const { sheet } = Astro.props;
---

<Base title={sheet.title} section="cheatsheets" description={sheet.summary}>
  <nav aria-label="Breadcrumb" class="crumbs">
    <a href="/cheatsheets">Cheatsheets</a>
    <span aria-hidden="true">/</span>
    <span>{sheet.title}</span>
  </nav>

  <h1>{sheet.title}</h1>
  <p class="lede">{sheet.summary}</p>

  <dl class="sheet">
    {
      sheet.entries.map((entry) => (
        <div class="sheet__entry">
          <dt>{entry.want}</dt>
          <dd>
            <pre>
              <code>{entry.code}</code>
            </pre>
            {entry.note && <p class="sheet__note">{entry.note}</p>}
          </dd>
        </div>
      ))
    }
  </dl>

  <style>
    .crumbs {
      color: var(--ink-muted);
      font-size: 0.875rem;
      margin-bottom: var(--space-3);
    }
    .lede {
      font-size: var(--step-1);
      color: var(--ink-muted);
      max-width: var(--measure);
    }
    .sheet {
      margin: var(--space-5) 0 0;
    }
    .sheet__entry {
      border-top: 1px solid var(--rule);
      padding: var(--space-4) 0;
      display: grid;
      gap: var(--space-3);
    }
    @media (min-width: 800px) {
      .sheet__entry {
        grid-template-columns: 22ch 1fr;
      }
    }
    .sheet dt {
      font-weight: 500;
    }
    .sheet dd {
      margin: 0;
    }
    .sheet pre {
      margin: 0;
    }
    .sheet__note {
      margin: var(--space-2) 0 0;
      color: var(--ink-muted);
      font-size: 0.875rem;
    }
  </style>
</Base>
