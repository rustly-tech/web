---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** Nav item to mark as current. */
  section?: string;
}

const { title, description, section } = Astro.props;
const fullTitle = title === 'Rustly' ? title : `${title} · Rustly`;

const nav = [
  { href: '/learn', label: 'Learn', id: 'learn' },
  { href: '/trials', label: 'Trials', id: 'trials' },
  { href: '/cheatsheets', label: 'Cheatsheets', id: 'cheatsheets' },
  { href: '/workspace', label: 'Workspace', id: 'workspace' },
  { href: '/community', label: 'Community', id: 'community' },
  { href: '/rankings', label: 'Rankings', id: 'rankings' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site ?? 'https://rustly.tech')} />
    <meta name="color-scheme" content="light dark" />
  </head>
  <body>
    <div class="shell">
      <a class="skip-link" href="#main">Skip to content</a>

      <header class="masthead">
        <div class="masthead__inner">
          <a class="wordmark" href="/">Rustly</a>
          <nav aria-label="Primary">
            {
              nav.map((item) => (
                <a href={item.href} aria-current={section === item.id ? 'page' : undefined}>
                  {item.label}
                </a>
              ))
            }
          </nav>
        </div>
      </header>

      <main id="main">
        <slot />
      </main>

      <footer class="colophon">
        <div class="colophon__inner">
          <span>Rustly · learn Rust by writing, breaking, fixing, and reading real Rust</span>
          <span class="cluster">
            <a href="https://github.com/rustly-tech">Source</a>
            <a href="/recent">Recent</a>
            <a href="/archive">Archive</a>
          </span>
        </div>
      </footer>
    </div>
  </body>
</html>
